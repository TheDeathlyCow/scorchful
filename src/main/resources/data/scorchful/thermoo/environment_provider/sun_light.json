                    }
                }
            },
            "below": {
                "type": "thermoo:reduce_constant",
                "components": {
                    "thermoo:temperature": {
                        "value": -10.0,
                        "unit": "kelvin"
                    }
                }
            }
        },
        "below": {
            "type": "thermoo:replace_constant",
