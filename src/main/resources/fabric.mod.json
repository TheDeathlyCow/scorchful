{
	"schemaVersion": 1,
	"id": "scorchful",
	"version": "${version}",
	"name": "Scorchful",
	"description": "A mod focused on Heat based survival and combat. Also try Frostiful!",
	"authors": [
		"TheDeathlyCow"
	],
	"contributors": [
		"NerjalNosk (Various compatibility patches)",
		"godkyo98 (Vietnamese Translation)",
		"noawx (Finnish Translation)",
		"JellyBubb1e (Chinese Translation)",
        "StarmanMine142 (Ukrainian Translation)",
        "aiocringe (Russian Translation)"
	],
	"contact": {
		"homepage": "https://www.thedeathlycow.com/scorchful",
		"sources": "https://github.com/TheDeathlyCow/scorchful",
		"issues": "https://github.com/TheDeathlyCow/scorchful/issues"
	},
	"license": "LGPL-3.0",
	"icon": "assets/scorchful/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.github.thedeathlycow.scorchful.Scorchful"
		],
		"client": [
			"com.github.thedeathlycow.scorchful.ScorchfulClient"
		],
		"modmenu": [
			"com.github.thedeathlycow.scorchful.ScorchfulModMenu"
		],
		"cardinal-components-entity": [
			"com.github.thedeathlycow.scorchful.cca.ScorchfulCardinalEntityComponents"
		]
	},
	"mixins": [
		"scorchful.mixins.json",
		{
			"config": "scorchful.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": ">=1.21.11",
		"java": ">=21",
		"fabric-api": ">=0.145.1",
		"yet_another_config_lib_v3": ">=3.8.1",
		"cardinal-components-base": ">=7.3.0",
		"thermoo": ">=9.0.0"
	},
	"suggests": {
		"frostiful": "*",
		"thermoo-patches": "*"
	},
	"accessWidener": "scorchful.accesswidener",
	"custom": {
		"loom:injected_interfaces": {
			"net/minecraft/world/damagesource/DamageSources": [
				"com/github/thedeathlycow/scorchful/world/ScorchfulDamageSources"
			],
			"net/minecraft/world/level/biome/Biome": [
				"com/github/thedeathlycow/scorchful/world/ScorchfulBiome"
			]
		},
		"cardinal-components": [
			"scorchful:player_water",
			"scorchful:entity_desert_vision",
			"scorchful:rehydration"
		],
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.thedeathlycow.com",
				"modmenu.wiki": "https://modded.wiki/w/Scorchful",
				"modmenu.kofi": "https://ko-fi.com/thedeathlycow",
				"modmenu.modrinth": "https://modrinth.com/mod/scorchful"
			}
		}
	}
}